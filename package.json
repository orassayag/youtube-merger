{
  "name": "youtube-merger",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "A TypeScript CLI tool that migrates YouTube subscriptions, playlists, and liked videos from Google Takeout CSV exports to another account using the YouTube Data API v3, with OAuth2, rate-limit-aware retries, and configurable sections",
  "keywords": [
    "youtube",
    "takeout",
    "migration",
    "csv",
    "google-apis",
    "youtube-data-api",
    "cli",
    "typescript",
    "oauth2",
    "playlists",
    "subscriptions"
  ],
  "author": "Or Assayag",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/orassayag/youtube-merger"
  },
  "bugs": {
    "url": "https://github.com/orassayag/youtube-merger/issues"
  },
  "homepage": "https://github.com/orassayag/youtube-merger#readme",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "migrate": "tsx src/main.ts",
    "build": "tsc",
    "test": "cross-env NODE_OPTIONS='--no-warnings' vitest run --coverage",
    "test:watch": "cross-env NODE_OPTIONS='--no-warnings' vitest",
    "test:no-coverage": "cross-env NODE_OPTIONS='--no-warnings' vitest run",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "prettier": "prettier --check \"src/**/*.ts\"",
    "prettier:fix": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "csv-parse": "^6.2.1",
    "google-auth-library": "^10.7.0",
    "googleapis": "^173.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@vitest/coverage-istanbul": "^4.1.8",
    "@vitest/ui": "^4.1.8",
    "cross-env": "^10.1.0",
    "eslint": "^10.4.1",
    "prettier": "^3.8.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
