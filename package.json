{
  "name": "youtube-merger",
  "version": "1.0.0",
  "private": false,
  "description": "A TypeScript CLI migrating YouTube subscriptions, playlists and liked videos from Google Takeout export to target account using YouTube Data API version v3, OAuth 2.0 desktop, rate-limit retries, configurable sections, it Reads CSVs to batch-import subs, recreate playlists, like videos, quotas",
  "keywords": [
    "youtube",
    "takeout",
    "migration",
    "csv",
    "google-apis",
    "youtube-data-api",
    "cli",
    "typescript",
    "oauth2",
    "playlists",
    "subscriptions"
  ],
  "homepage": "https://github.com/orassayag/youtube-merger#readme",
  "bugs": {
    "url": "https://github.com/orassayag/youtube-merger/issues"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/orassayag/youtube-merger.git"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/orassayag"
  },
  "license": "MIT",
  "author": {
    "name": "Or Assayag",
    "email": "orassayag@gmail.com",
    "url": "https://github.com/orassayag"
  },
  "contributors": [
    {
      "name": "Or Assayag",
      "email": "orassayag@gmail.com",
      "url": "https://github.com/orassayag"
    }
  ],
  "type": "module",
  "main": "src/main.ts",
  "files": [
    ".github",
    ".pnpm-store",
    ".vscode",
    "dist",
    "src",
    ".eslintignore",
    ".gitignore",
    ".npmrc",
    ".prettierrc",
    ".prettierrc.json",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "eslint.config.mjs",
    "INSTRUCTIONS.md",
    "knip.json",
    "LICENSE",
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "README.md",
    "SECURITY.md",
    "tsconfig.json",
    "tsconfig.node.json",
    "vitest.config.ts"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "migrate": "tsx src/main.ts",
    "prettier": "prettier --check \"src/**/*.ts\"",
    "prettier:fix": "prettier --write \"src/**/*.ts\"",
    "start": "tsx src/main.ts",
    "test": "cross-env NODE_OPTIONS='--no-warnings' vitest run --coverage",
    "test:no-coverage": "cross-env NODE_OPTIONS='--no-warnings' vitest run",
    "test:watch": "cross-env NODE_OPTIONS='--no-warnings' vitest"
  },
  "dependencies": {
    "csv-parse": "^7.0.2",
    "googleapis": "^174.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitest/coverage-istanbul": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "cross-env": "^10.1.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  }
}
